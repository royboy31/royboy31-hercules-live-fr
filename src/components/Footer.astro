---
// Global Footer Component - redesigned 2026-08 (reseller banner + link columns + help/contact)
import ContactFormPopup from './ContactFormPopup.tsx';

const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    heading: 'Entreprise',
    links: [
      { label: 'À propos de nous', href: '/a-propos/' },
      { label: 'Notre équipe', href: '/notre-equipe/' },
      { label: 'Blog', href: '/blogs/news/' },
      { label: 'Livraisons et retours', href: '/livraisons-et-retours/' },
      { label: 'Moyens de paiement', href: '/moyens-de-paiement/' },
      { label: 'Contact', href: '/contactez-nous/' },
      { label: 'Mon compte', href: '/mon-compte/' },
    ],
  },
  {
    heading: 'Produits',
    links: [
      { label: 'Écharpes', href: '/collections/echarpes-personnalisees/' },
      { label: 'Bonnets', href: '/collections/bonnets-personnalises-football/' },
      { label: 'Couvre-chefs', href: '/collections/couvre-chefs/' },
      { label: 'Vêtements de sport', href: '/collections/equipements-personnalises/' },
      { label: 'Fanions', href: '/collections/fanions-personnalises-football/' },
      { label: 'Accessoires', href: '/collections/accessoires-de-football/' },
      { label: 'Tifo', href: '/collections/tifo/' },
    ],
  },
  {
    heading: 'Sports',
    links: [
      { label: 'Football', href: '/collections/football/' },
      { label: 'Rugby', href: '/collections/rugby/' },
      { label: 'Basket-ball', href: '/collections/basket-ball/' },
      { label: 'Running', href: '/collections/running/' },
      { label: 'Cyclisme', href: '/collections/cyclisme/' },
      { label: 'Volleyball', href: '/collections/volleyball/' },
      { label: 'Fitness', href: '/collections/fitness/' },
    ],
  },
];

const socialLinks = [
  { platform: 'linkedin', label: 'LinkedIn', href: '' },
  { platform: 'instagram', label: 'Instagram', href: '' },
  { platform: 'facebook', label: 'Facebook', href: '' },
  { platform: 'youtube', label: 'YouTube', href: '' },
];

const phones = [
  { tel: '+33973030295', display: '+33 9 73 03 02 95' },
  { tel: '+3228087090', display: '+32 2 808 70 90' },
];
---

<footer class="site-footer">
  <!-- Reseller Banner -->
  <div class="banner-wrap">
    <div class="reseller-banner">
      <div class="banner-intro">
        <div class="banner-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M223.68,66.15,135.68,18a15.88,15.88,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a15.88,15.88,0,0,0,15.36,0l88-48.17a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15ZM128,32l80.34,44-29.77,16.3-80.35-44ZM128,120,47.66,76l33.9-18.56,80.34,44ZM40,90l80,43.78v85.79L40,175.82Zm96,129.57V133.82L166,117.36V152a8,8,0,0,0,16,0V108.61l34-18.61v85.82Z"></path></svg>
          <span class="banner-icon-badge">%</span>
        </div>
        <div class="banner-text">
          <h2 class="banner-heading">Revendeur ou club professionnel ?</h2>
          <p class="banner-description">Devenez partenaire et bénéficiez de tarifs exclusifs, d'un accompagnement dédié et de livraisons fiables pour vos commandes en gros.</p>
        </div>
      </div>
      <div class="banner-features">
        <div class="banner-feature">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M243.31,136,144,36.69A15.86,15.86,0,0,0,132.69,32H40a8,8,0,0,0-8,8v92.69A15.86,15.86,0,0,0,36.69,144L136,243.31a16,16,0,0,0,22.63,0l84.68-84.68a16,16,0,0,0,0-22.63Zm-96,96L48,132.69V48h84.69L232,147.31ZM96,84A12,12,0,1,1,84,72,12,12,0,0,1,96,84Z"></path></svg>
          <span>Tarifs de gros exclusifs</span>
        </div>
        <div class="banner-feature">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M201.89,54.66A103.43,103.43,0,0,0,128.79,24H128A104,104,0,0,0,24,128v56a24,24,0,0,0,24,24H64a24,24,0,0,0,24-24V144a24,24,0,0,0-24-24H40.36A88.12,88.12,0,0,1,190.54,65.93,87.39,87.39,0,0,1,215.65,120H192a24,24,0,0,0-24,24v40a24,24,0,0,0,24,24h24a24,24,0,0,1-24,24H136a8,8,0,0,0,0,16h56a40,40,0,0,0,40-40V128A103.41,103.41,0,0,0,201.89,54.66ZM64,136a8,8,0,0,1,8,8v40a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V136Zm128,56a8,8,0,0,1-8-8V144a8,8,0,0,1,8-8h24v56Z"></path></svg>
          <span>Accompagnement dédié</span>
        </div>
      </div>
      <div class="banner-cta">
        <ContactFormPopup client:visible triggerType="button" triggerText="Contactez notre équipe" triggerClassName="banner-cta-popup" />
        <div class="banner-phone">
          {phones.map((phone) => (
            <a href={`tel:${phone.tel}`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46ZM176,208A128.14,128.14,0,0,1,48,80,40.2,40.2,0,0,1,82.87,40a.61.61,0,0,0,0,.12l21,47L83.2,111.86a6.13,6.13,0,0,0-.57.77,16,16,0,0,0-1,15.7c9.06,18.53,27.73,37.06,46.46,46.11a16,16,0,0,0,15.75-1.14,8.44,8.44,0,0,0,.74-.56L168.89,152l47,21.05h0s.08,0,.11,0A40.21,40.21,0,0,1,176,208Z"></path></svg>
              <span>{phone.display}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="main-footer">
    <div class="footer-container">
      <!-- Logo Column -->
      <div class="footer-column logo-column">
        <a href="/">
          <img
            src="/images/hercules-logo-original1.webp"
            srcset="/images/hercules-logo-original1.webp 1x, /images/hercules-logo-original1-2x.webp 2x"
            alt="Hercules Merchandising"
            class="footer-logo"
            loading="lazy"
            width="176"
            height="78"
          />
        </a>
        <p class="footer-tagline">Du merchandising et des vêtements de qualité pour les clubs, les supporters et les équipes en France et au-delà.</p>
      </div>

      {footerColumns.map((col) => (
        <div class="footer-column">
          <h3 class="footer-heading">{col.heading}</h3>
          <ul class="footer-links">
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Help / Contact Column -->
      <div class="footer-column help-column">
        <h3 class="footer-heading">Aide / Contact</h3>
        <div class="footer-phone">
          {phones.map((phone) => (
            <a href={`tel:${phone.tel}`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46ZM176,208A128.14,128.14,0,0,1,48,80,40.2,40.2,0,0,1,82.87,40a.61.61,0,0,0,0,.12l21,47L83.2,111.86a6.13,6.13,0,0,0-.57.77,16,16,0,0,0-1,15.7c9.06,18.53,27.73,37.06,46.46,46.11a16,16,0,0,0,15.75-1.14,8.44,8.44,0,0,0,.74-.56L168.89,152l47,21.05h0s.08,0,.11,0A40.21,40.21,0,0,1,176,208Z"></path></svg>
              <span>{phone.display}</span>
            </a>
          ))}
        </div>
        <h3 class="footer-heading follow-heading">Suivez-nous</h3>
        <div class="social-icons">
          {socialLinks.map((social) => (
            <a href={social.href || '#'} class="social-icon" aria-label={social.label} target="_blank" rel="noopener">
              {social.platform === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"></path></svg>
              )}
              {social.platform === 'instagram' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5.25" fill="none" stroke="currentColor" stroke-width="1.8"></rect><circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.8"></circle><circle cx="17.1" cy="6.9" r="1.25" fill="currentColor" stroke="none"></circle></svg>
              )}
              {social.platform === 'facebook' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M13.4 21v-8.2h2.75l.41-3.2H13.4V7.56c0-.92.26-1.55 1.58-1.55h1.69V3.14A22.5 22.5 0 0 0 14.21 3c-2.44 0-4.1 1.49-4.1 4.22v2.38H7.35v3.2h2.76V21z"></path></svg>
              )}
              {social.platform === 'youtube' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.58 7.19a2.51 2.51 0 0 0-1.77-1.77C18.25 5 12 5 12 5s-6.25 0-7.81.42A2.51 2.51 0 0 0 2.42 7.19 26.2 26.2 0 0 0 2 12a26.2 26.2 0 0 0 .42 4.81 2.51 2.51 0 0 0 1.77 1.77C5.75 19 12 19 12 19s6.25 0 7.81-.42a2.51 2.51 0 0 0 1.77-1.77A26.2 26.2 0 0 0 22 12a26.2 26.2 0 0 0-.42-4.81zM10 15.13V8.87L15.19 12z"></path></svg>
              )}
            </a>
          ))}
        </div>
        <ContactFormPopup client:visible triggerType="button" triggerText="Contactez-nous" triggerClassName="footer-cta-popup" />
      </div>
    </div>
  </div>

  <!-- Bottom Footer -->
  <div class="bottom-footer">
    <div class="footer-container bottom-container">
      <!-- Row 1: Legal links, Payment icons, Language switcher -->
      <div class="bottom-footer-row">
        <div class="legal-links">
          <a href="/conditions-generales-de-vente/">Conditions Générales de Vente</a>
          <a href="/politique-de-confidentialite-et-de-cookies/">Politique de confidentialité et de cookies</a>
          <a href="/mentions-legales/">Mentions légales</a>
        </div>
        <div class="payment-icons">
          <img src="/images/pay-her-2.png" alt="Moyens de paiement" loading="lazy" width="300" height="30" />
        </div>
        <div class="language-switcher">
          <button class="language-current" type="button">
<img src="/images/flags/fr-flag.png" alt="Drapeau français - Langue actuelle" width="24" height="24" loading="lazy" />
            <span>France</span>
            <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="language-dropdown">
            <li>
              <a href="https://hercules-merchandise.co.uk/" target="_blank">
<img src="/images/flags/uk-flag.png" alt="Drapeau britannique - Site Royaume-Uni" width="24" height="24" loading="lazy" />
                <span>Royaume-Uni</span>
              </a>
            </li>
            <li>
              <a href="https://www.hercules-merchandise.nl/" target="_blank">
<img src="/images/flags/nl-flag.png" alt="Drapeau néerlandais - Site Pays-Bas" width="24" height="24" loading="lazy" />
                <span>Pays-Bas</span>
              </a>
            </li>
            <li>
              <a href="https://hercules-merchandise.de/" target="_blank">
<img src="/images/german.png" alt="Drapeau allemand - Site Allemagne" width="24" height="24" loading="lazy" />
                <span>Allemagne</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <!-- Row 2: Copyright -->
      <div class="copyright">
        &copy; {currentYear} Be Ventures SRL, exploitant le site sous le nom commercial Hercules Merchandising. Tous droits réservés.
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background-color: #E8F5FF;
  }

  /* Reseller Banner */
  .banner-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px 20px 0 20px;
  }

  .reseller-banner {
    background-color: #F4F9FE;
    border-radius: 24px;
    padding: 40px 45px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }

  .banner-intro {
    display: flex;
    align-items: center;
    gap: 25px;
    flex: 1 1 380px;
  }

  .banner-icon {
    position: relative;
    width: 100px;
    height: 100px;
    background-color: #DFEBF6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .banner-icon > svg {
    width: 46px;
    height: 46px;
    fill: #253461;
  }

  .banner-icon-badge {
    position: absolute;
    top: 6px;
    right: 2px;
    width: 28px;
    height: 28px;
    background-color: #10C99E;
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 600;
  }

  .banner-heading {
    font-family: 'Jost', sans-serif;
    font-size: 22px;
    font-weight: 600;
    text-transform: uppercase;
    color: #253461;
    margin: 0 0 10px 0;
    max-width: 280px;
  }

  .banner-description {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #253461;
    margin: 0;
    max-width: 300px;
  }

  .banner-features {
    display: flex;
    align-items: center;
    gap: 0;
    flex: 0 1 auto;
  }

  .banner-feature {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 28px;
  }

  .banner-feature + .banner-feature {
    border-left: 1px solid rgba(37, 52, 97, 0.15);
  }

  .banner-feature svg {
    width: 38px;
    height: 38px;
    fill: #10C99E;
    flex-shrink: 0;
  }

  .banner-feature span {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.35;
    color: #253461;
    max-width: 110px;
  }

  .banner-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-left: 40px;
    border-left: 1px solid rgba(37, 52, 97, 0.15);
  }

  .banner-cta :global(.contact-trigger-button) {
    display: inline-block;
    padding: 13px 35px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    color: #FFFFFF;
    background-color: #10C99E;
    border: 1px solid #10C99E;
    border-radius: 100px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .banner-cta :global(.contact-trigger-button:hover) {
    background-color: transparent;
    color: #10C99E;
  }

  .banner-phone {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .banner-phone a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Jost', sans-serif;
    font-size: 17px;
    font-weight: 500;
    color: #253461;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .banner-phone svg {
    width: 22px;
    height: 22px;
    fill: #253461;
    flex-shrink: 0;
  }

  .banner-phone a:hover {
    color: #469ADC;
  }

  .banner-phone a:hover svg {
    fill: #469ADC;
  }

  /* Main Footer */
  .main-footer {
    padding: 40px 0 35px 0;
  }

  .main-footer .footer-container {
    border-top: 1px solid rgba(37, 52, 97, 0.12);
    padding-top: 45px;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
  }

  .footer-column {
    flex: 1;
    min-width: 150px;
  }

  .logo-column {
    min-width: 240px;
    flex: 1.3;
  }

  .footer-logo {
    max-width: 190px;
    height: auto;
  }

  .footer-tagline {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: #253461;
    margin: 20px 0 0 0;
    max-width: 240px;
  }

  .footer-heading {
    font-family: 'Jost', sans-serif;
    font-size: 18px;
    font-weight: 500;
    text-transform: uppercase;
    color: #253461;
    margin: 0 0 22px 0;
    position: relative;
    padding-bottom: 10px;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background-color: #10C99E;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 10px;
  }

  .footer-links a {
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #253461;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #469ADC;
    transform: translateX(3px);
  }

  /* Help / Contact Column */
  .help-column {
    min-width: 210px;
  }

  .footer-phone {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-phone a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    color: #253461;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .footer-phone a:hover {
    color: #469ADC;
  }

  .footer-phone svg {
    width: 20px;
    height: 20px;
    fill: #253461;
    flex-shrink: 0;
    transition: fill 0.3s ease;
  }

  .footer-phone a:hover svg {
    fill: #469ADC;
  }

  .follow-heading {
    margin-top: 30px;
  }

  .social-icons {
    display: flex;
    gap: 12px;
    margin-bottom: 25px;
  }

  .social-icon {
    width: 44px;
    height: 44px;
    border: 1.5px solid rgba(37, 52, 97, 0.35);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #253461;
    transition: all 0.3s ease;
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .social-icon:hover {
    border-color: #10C99E;
    color: #10C99E;
  }

  /* Footer Contact Popup Trigger */
  .footer-cta-popup :global(.contact-trigger-button) {
    display: block;
    width: 100%;
    max-width: 210px;
    text-align: center;
    padding: 13px 30px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    color: #FFFFFF;
    background-color: #10C99E;
    border: 1px solid #10C99E;
    border-radius: 100px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .footer-cta-popup :global(.contact-trigger-button:hover) {
    background-color: transparent;
    color: #10C99E;
  }

  /* Bottom Footer */
  .bottom-footer {
    background-color: #E8F5FF;
