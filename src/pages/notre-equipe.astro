---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Notre équipe | Hercules Merchandising';
const pageDescription = "Découvrez les personnes derrière Hercules Merchandising — les chefs de projet, designers et développeurs qui accompagnent votre projet de merchandising personnalisé du concept à la livraison.";

const team = [
  {
    name: 'Cedric',
    role: 'Chef de projet',
    image: '/images/team/cedric.webp',
    favourite: 'Écharpe de football HD',
    linkedin: 'https://www.linkedin.com/in/cedricdeschrijver/',
    bio: "Pour Cedric, le client passe toujours en premier. Clair, structuré et attentif dans sa communication, il prend le temps de comprendre les besoins de chaque client et maintient les projets dans la bonne direction. Il travaille aussi à l'amélioration des processus internes, tient la documentation à jour et soutient la stratégie marketing afin que Hercules Merchandising reste professionnel, pertinent et simple dans la collaboration."
  },
  {
    name: 'Gilles',
    role: 'Chef de projet',
    image: '/images/team/gilles.webp',
    favourite: 'Maillot de football rétro',
    linkedin: 'https://www.linkedin.com/in/gillesvandoorne/',
    bio: "Gilles aide les clients à transformer leurs idées en projets de merchandising clairs et réalistes. Il s'attache à comprendre ce que chaque club, marque ou organisation souhaite accomplir, puis accompagne le projet de la première idée jusqu'à la livraison finale. Avec un œil pratique pour le design, la production et la planification, il veille à ce que les clients reçoivent des conseils honnêtes, utiles et faciles à mettre en œuvre."
  },
  {
    name: 'Lea-Marie',
    role: 'Cheffe de projet',
    image: '/images/team/lea-marie.webp',
    favourite: 'Écharpe en coton recyclé',
    linkedin: 'https://www.linkedin.com/in/lea-marie-g%C3%B6tze/',
    bio: "Lea-Marie veille à ce que les projets avancent sans accroc sur les marchés britannique et allemand. Organisée, accessible et attentive aux détails, elle aide à transformer les idées des clients en produits adaptés tout en s'assurant que rien n'est oublié en cours de route. Elle contribue également au site web en ajoutant de nouveaux produits et en gardant les informations produit à jour, claires et utiles pour les clients."
  },
  {
    name: 'Zhaks',
    role: 'Designer',
    image: '/images/team/zhaks.webp',
    favourite: 'Bonnet personnalisé',
    linkedin: null,
    bio: "Zhaks crée des designs de merchandising pour les clubs sportifs, les marques et les organisations. Son travail couvre tout, des écharpes et de la maille aux emballages, drapeaux et articles promotionnels. Il aime partir d'une idée et la transformer en produit fini qui a de l'allure, fonctionne en production et que les gens peuvent réellement utiliser, porter et apprécier."
  },
  {
    name: 'Dilan',
    role: 'Designer',
    image: '/images/team/dilan.webp',
    favourite: 'Écharpe personnalisée',
    linkedin: null,
    bio: "Dilan transforme les idées des clients en designs prêts pour la production. Chaque produit apporte ses propres défis, des écharpes et maillots de football aux fanions, serviettes et autres articles personnalisés, et il aime s'assurer que chaque détail fonctionne avant l'impression. Son produit préféré est l'écharpe personnalisée, parce qu'elle offre d'innombrables possibilités créatives, des couleurs de supporters affirmées aux motifs tissés détaillés."
  },
  {
    name: 'Roy',
    role: 'Développeur',
    image: '/images/team/roy.webp',
    favourite: 'Maillot de football personnalisé',
    linkedin: null,
    bio: "Roy travaille à rendre le site de Hercules Merchandising aussi clair, simple et agréable que possible. Son objectif : que chaque client puisse explorer les produits, comprendre les options disponibles et voir les prix clairement, sans avoir besoin d'aide supplémentaire. Son produit préféré est le maillot de football personnalisé, parce qu'il rassemble les gens et donne aux entreprises, clubs et groupes de supporters quelque chose qui leur ressemble immédiatement."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageType="page"
>
  <!-- Hero Section -->
  <section class="team-hero">
    <div class="container">
      <div class="team-hero-text">
        <h1>L'équipe derrière<br />Hercules Merchandising</h1>
        <div class="hero-accent"></div>
        <p>Derrière chaque projet réussi, il y a une équipe de personnes attentives aux détails. Chez Hercules Merchandising, vous travaillez avec de vraies personnes qui accompagnent votre projet du concept à la livraison, en combinant connaissance des produits, conseils pratiques et souci du détail.</p>
        <p>Nous croyons en une communication honnête, des délais réalistes et un design pensé pour la production. Notre objectif est simple : rendre le processus facile, transparent et agréable, tout en livrant du merchandising que votre communauté sera fière de porter.</p>
      </div>
    </div>
  </section>

  <!-- Our Team -->
  <section class="team-section">
    <div class="container">
      <h2 class="section-title">Notre équipe</h2>
      <p class="section-intro">Les personnes qui guident votre projet, façonnent vos designs et font avancer les choses.</p>

      <div class="team-list">
        {team.map((member) => (
          <article class="team-card">
            <div class="team-photo">
              <img src={member.image} alt={`${member.name} — ${member.role} chez Hercules Merchandising`} width="140" height="140" loading="lazy" />
            </div>
            <div class="team-identity">
              <h3>{member.name}</h3>
              <p class="team-role">{member.role}</p>
            </div>
            <div class="team-bio">
              <p>{member.bio}</p>
            </div>
            <div class="team-meta">
              <p class="team-favourite"><span>Article de merch préféré :</span>{member.favourite}</p>
              {member.linkedin && (
                <a class="team-linkedin" href={member.linkedin} target="_blank" rel="noopener noreferrer">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                  LinkedIn
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="team-section team-section-alt">
    <div class="container">
      <h2 class="section-title">Notre façon de travailler</h2>
      <p class="section-intro">Nous suivons un processus simple et éprouvé qui place vos objectifs en premier. Nous écoutons, conseillons et vous guidons à chaque décision, pour que vous sachiez toujours ce qui se passe et pourquoi. Nos principes gardent les projets sur la bonne voie et votre expérience sans stress.</p>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              <line x1="8" y1="9" x2="16" y2="9"></line>
              <line x1="8" y1="13" x2="13" y2="13"></line>
            </svg>
          </div>
          <h3>Conseils honnêtes</h3>
          <p>Nous recommandons ce qui fonctionne, pas seulement ce qui sonne bien. Des conseils directs auxquels vous pouvez faire confiance.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>Souci du détail</h3>
          <p>De la vérification des designs à la planification des livraisons, nous nous concentrons sur les petites choses qui font une grande différence.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
            </svg>
          </div>
          <h3>Vision à long terme</h3>
          <p>Nous construisons des partenariats fiables et nous soucions de votre réussite, aujourd'hui et pour les saisons à venir.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Hero Section */
  .team-hero {
    background: #EFF4FA;
    padding: 70px 0;
  }

  .team-hero-text {
    max-width: 760px;
  }

  h1 {
    font-family: 'Jost', sans-serif;
    font-size: 48px;
    font-weight: 600;
    color: #253461;
    text-transform: uppercase;
    line-height: 1.15;
    margin: 0 0 18px;
  }

  .hero-accent {
    width: 70px;
    height: 4px;
    background: #10C99E;
    margin: 0 0 25px;
  }

  .team-hero-text p {
    font-family: 'Roboto', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: #5F5F5F;
    margin: 0 0 15px;
  }

  /* Shared Section Styles */
  .team-section {
    padding: 70px 0;
    background: #FFFFFF;
  }

  .team-section-alt {
    background: #FAFAFA;
  }

  .section-title {
    font-family: 'Jost', sans-serif;
    font-size: 35px;
    font-weight: 600;
    color: #253461;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 15px;
  }

  .section-intro {
    font-family: 'Roboto', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: #5F5F5F;
    text-align: center;
    max-width: 750px;
    margin: 0 auto;
  }

  /* Team Cards */
  .team-list {
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-top: 45px;
  }

  .team-card {
    display: grid;
    grid-template-columns: 140px 170px 1fr 220px;
    gap: 30px;
    align-items: center;
    background: #FFFFFF;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .team-photo img {
    display: block;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #EFF4FA;
  }

  .team-identity h3 {
    font-family: 'Jost', sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #253461;
    text-transform: uppercase;
    margin: 0 0 5px;
  }

  .team-role {
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #10C99E;
    margin: 0;
  }

  .team-bio p {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #5F5F5F;
    margin: 0;
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .team-favourite {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #253461;
    margin: 0;
  }

  .team-favourite span {
    display: block;
    font-weight: 700;
    margin-bottom: 3px;
  }

  .team-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #469ADC;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .team-linkedin:hover {
    color: #253461;
  }

  /* Values Grid */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 45px;
  }

  .value-card {
    background: #FFFFFF;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .value-icon {
    margin-bottom: 15px;
  }

  .value-card h3 {
    font-family: 'Jost', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #253461;
    margin: 0 0 12px;
  }

  .value-card p {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #5F5F5F;
    margin: 0;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .team-card {
      grid-template-columns: 120px 1fr;
      grid-template-rows: auto auto auto;
      row-gap: 15px;
    }

    .team-photo img {
      width: 120px;
      height: 120px;
    }

    .team-bio,
    .team-meta {
      grid-column: 1 / -1;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }

    .team-hero {
      padding: 45px 0;
    }

    h1 {
      font-size: 30px;
    }

    .team-hero-text p {
      font-size: 15px;
    }

    .team-section {
      padding: 45px 0;
    }

    .section-title {
      font-size: 24px;
    }

    .section-intro {
      font-size: 15px;
    }

    .team-card {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 25px 20px;
    }

    .team-photo img {
      width: 110px;
      height: 110px;
    }

    .team-bio,
    .team-meta {
      grid-column: auto;
    }

    .team-meta {
      align-items: center;
    }
  }
</style>
