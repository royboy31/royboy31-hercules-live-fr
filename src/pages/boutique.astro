---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryProductCard from '../components/CategoryProductCard.astro';
import TrustLogos from '../components/TrustLogos.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import { siteConfig, getBreadcrumbSchema, truncateDescription } from '../config/seo';

const WORKER_URL = import.meta.env.WORKER_URL || 'https://hercules-product-sync-fr.gilles-86d.workers.dev';

// Fetch all products
let products: any[] = [];
try {
  const res = await fetch(`${WORKER_URL}/products-full`);
  if (res.ok) {
    const data = await res.json();
    products = (Array.isArray(data) ? data : data.products || [])
      .filter((p: any) => p && p.images?.length > 0)
      .sort((a: any, b: any) => (a.menu_order ?? 999) - (b.menu_order ?? 999));
  }
} catch (e) {
  console.error('Error fetching products:', e);
}

const canonicalUrl = `${siteConfig.siteUrl}/boutique/`;
const pageDescription = 'Découvrez notre boutique en ligne de merchandising sportif personnalisé. Écharpes, bonnets, fanions, vêtements de sport et bien plus encore, fabriqués en Europe.';

const jsonLdSchemas = [
  getBreadcrumbSchema([
    { name: 'Accueil', url: siteConfig.siteUrl },
    { name: 'Boutique', url: canonicalUrl },
  ]),
];

const lcpImageUrl = products.length > 0 ? `${WORKER_URL}/image/${products[0].slug}` : null;
const preloadImages = lcpImageUrl ? [lcpImageUrl] : [];
---

<BaseLayout
  title="Boutique"
  description={pageDescription}
  pageType="collection"
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLdSchemas}
  preloadImages={preloadImages}
>
  <section class="category-page">
    <div class="category-container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" itemprop="item"><span itemprop="name">Accueil</span></a>
            <meta itemprop="position" content="1" />
            <span class="separator"><img src="/images/breadcrumb-separator.svg" alt="" width="6" height="12" /></span>
          </li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">Boutique</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="category-header">
        <h1 class="category-title">Boutique Hercules</h1>
        <div class="category-description">
          <p>Découvrez notre collection complète de produits sportifs personnalisés — des tenues d'équipe et équipements d'entraînement aux écharpes et accessoires. Tous nos produits sont fabriqués sur commande et entièrement personnalisables avec les couleurs, logos et designs de votre équipe.</p>
        </div>
      </header>

      <!-- Product Grid -->
      {products.length > 0 ? (
        <ul class="products">
          {products.map((product: any, index: number) => (
            <CategoryProductCard product={product} index={index} />
          ))}
        </ul>
      ) : (
        <div class="no-products">
          <p>Aucun produit disponible.</p>
        </div>
      )}

    </div>
  </section>

  <TrustLogos />
  <CustomerReviews />
</BaseLayout>

<style>
  .category-page {
    width: 100%;
    padding: 0;
    background: #FAFAFA;
    overflow-x: hidden;
  }

  .category-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  /* Breadcrumb */
  .breadcrumb {
    margin: 0;
    padding-top: 20px;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #787878;
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
  }

  .breadcrumb a {
    color: #787878;
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: #253461;
  }

  .breadcrumb .separator {
    display: flex;
    align-items: center;
    margin: 0 10px;
  }

  .breadcrumb .separator img {
    display: block;
    width: 6px;
    height: 12px;
    aspect-ratio: 6 / 12;
  }

  .breadcrumb li:last-child span[itemprop="name"] {
    color: #469ADC;
  }

  /* Category Header */
  .category-header {
    margin-bottom: 20px;
    text-align: center;
  }

  .category-title {
    font-family: 'Jost', 'Jost Fallback', sans-serif;
    font-size: 35px;
    font-weight: 600;
    color: #253461;
    margin: 20px 0 20px 0;
    text-transform: uppercase;
    line-height: 1.2;
    min-height: 42px;
  }

  .category-description {
    font-family: 'Roboto', 'Roboto Fallback', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7em;
    color: #626262;
    max-width: 75%;
    margin: 0 auto;
  }

  /* Product Grid */
  .products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 20px 0 40px 0;
    padding: 0;
    list-style: none;
  }

  .no-products {
    text-align: center;
    padding: 60px 20px;
    font-family: 'Roboto', sans-serif;
    font-size: 18px;
    color: #666;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .category-container { padding: 0 15px; }
    .products { grid-template-columns: repeat(2, 1fr); }
    .category-description { max-width: 90%; }
  }

  @media (max-width: 767px) {
    .category-page { padding: 0; }
    .category-container { padding: 0 10px; }
    .products { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .category-description { max-width: 100%; }
    .category-title { font-size: 28px; }
  }

  @media (max-width: 480px) {
    .products { grid-template-columns: 1fr; }
  }
</style>
