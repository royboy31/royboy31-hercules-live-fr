---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryProductCard from '../components/CategoryProductCard.astro';
import TrustLogos from '../components/TrustLogos.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import { siteConfig, getBreadcrumbSchema, truncateDescription } from '../config/seo';

const WORKER_URL = import.meta.env.WORKER_URL || 'https://hercules-product-sync-fr.gilles-86d.workers.dev';

// Fetch all products
let products: any[] = [];
try {
  const res = await fetch(`${WORKER_URL}/products-full`);
  if (res.ok) {
    const data = await res.json();
    products = (Array.isArray(data) ? data : data.products || [])
      .filter((p: any) => p && p.images?.length > 0)
      .sort((a: any, b: any) => (a.menu_order ?? 999) - (b.menu_order ?? 999));
  }
} catch (e) {
  console.error('Error fetching products:', e);
}

const canonicalUrl = `${siteConfig.siteUrl}/boutique/`;
const pageDescription = 'Découvrez notre boutique en ligne de merchandising sportif personnalisé. Écharpes, bonnets, fanions, vêtements de sport et bien plus encore, fabriqués en Europe.';

const jsonLdSchemas = [
  getBreadcrumbSchema([
    { name: 'Accueil', url: siteConfig.siteUrl },
    { name: 'Boutique', url: canonicalUrl },
  ]),
];

const lcpImageUrl = products.length > 0 ? `${WORKER_URL}/image/${products[0].slug}` : null;
const preloadImages = lcpImageUrl ? [lcpImageUrl] : [];
---

<BaseLayout
  title="Boutique"
  description={pageDescription}
  pageType="collection"
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLdSchemas}
  preloadImages={preloadImages}
>
  <section class="category-page">
    <div class="category-container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" itemprop="item"><span itemprop="name">Accueil</span></a>
            <meta itemprop="position" content="1" />
            <span class="separator"><img src="/images/breadcrumb-separator.svg" alt="" width="6" height="12" /></span>
          </li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">Boutique</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="category-header">
        <h1 class="category-title">Boutique Hercules</h1>
        <div class="category-description">
          <p>Découvrez notre collection complète de produits sportifs personnalisés — des tenues d'équipe et équipements d'entraînement aux écharpes et accessoires. Tous nos produits sont fabriqués sur commande et entièrement personnalisables avec les couleurs, logos et designs de votre équipe.</p>
        </div>
      </header>

      <!-- Product Grid -->
      {products.length > 0 ? (
        <ul class="products">
          {products.map((product: any, index: number) => (
            <CategoryProductCard product={product} index={index} />
          ))}
        </ul>
      ) : (
        <div class="no-products">
          <p>Aucun produit disponible.</p>
        </div>
      )}

    </div>
  </section>

  <TrustLogos />
  <CustomerReviews />
</BaseLayout>

<style>
  /* Reuse same styles as collection pages */
  .category-page {
    padding: 20px 0 60px;
  }

  .category-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    gap: 6px;
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    color: #787878;
  }

  .breadcrumb a {
    color: #787878;
    text-decoration: none;
  }

  .breadcrumb a:hover { color: #469ADC; }

  .separator { display: flex; align-items: center; }

  .category-header {
    margin-bottom: 30px;
  }

  .category-title {
    font-family: 'Jost', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: #253461;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }

  .category-description p {
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    color: #626262;
    margin: 0;
  }

  .products {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .no-products {
    text-align: center;
    padding: 60px 20px;
    color: #787878;
    font-family: 'Roboto', sans-serif;
  }

  @media (max-width: 1024px) {
    .products { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 767px) {
    .category-title { font-size: 24px; }
    .products { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
</style>
