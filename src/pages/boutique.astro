---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustLogos from '../components/TrustLogos.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import { siteConfig, getBreadcrumbSchema } from '../config/seo';
import { getMenuData } from '../data/menu-data';

const menuData = await getMenuData();

const canonicalUrl = `${siteConfig.siteUrl}/boutique/`;

const pageDescription = 'Découvrez notre boutique en ligne de merchandising sportif personnalisé. Écharpes, bonnets, fanions, vêtements de sport et bien plus encore, fabriqués en Europe.';

const jsonLdSchemas = [
  getBreadcrumbSchema([
    { name: 'Accueil', url: siteConfig.siteUrl },
    { name: 'Boutique', url: canonicalUrl },
  ]),
];

const sections = [
  { heading: 'Sports', items: menuData.sportarten },
  { heading: 'Produits', items: menuData.produkte },
  { heading: 'Thèmes',  items: menuData.themen },
];
---

<BaseLayout
  title="Boutique"
  description={pageDescription}
  pageType="page"
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLdSchemas}
>
  <section class="boutique-page">
    <div class="boutique-container">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" itemprop="item"><span itemprop="name">Accueil</span></a>
            <meta itemprop="position" content="1" />
            <span class="separator"><img src="/images/breadcrumb-separator.svg" alt="" width="6" height="12" /></span>
          </li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">Boutique</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </nav>

      <!-- Page Header -->
      <header class="boutique-header">
        <h1>Boutique</h1>
        <p class="boutique-intro">Découvrez notre collection complète de merchandising sportif personnalisé, fabriqué en Europe.</p>
      </header>

      <!-- Category Sections -->
      {sections.map(section => (
        <div class="boutique-section">
          <h2 class="section-heading">{section.heading}</h2>
          <ul class="categories-grid">
            {section.items.map((item, index) => (
              <li class="category-card">
                <a href={item.href} class="category-card-link">
                  <div class="category-icon-wrapper">
                    <img
                      src={item.icon_url}
                      alt={item.label}
                      loading={index < 8 ? 'eager' : 'lazy'}
                      width="60"
                      height="60"
                    />
                  </div>
                  <span class="category-name">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>
  </section>

  <TrustLogos />
  <CustomerReviews />
</BaseLayout>

<style>
  .boutique-page {
    padding: 20px 0 60px;
  }

  .boutique-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Breadcrumb */
  .breadcrumb ol {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
    gap: 6px;
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    color: #787878;
  }

  .breadcrumb a {
    color: #787878;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #469ADC;
  }

  .separator {
    display: flex;
    align-items: center;
  }

  /* Header */
  .boutique-header {
    margin-bottom: 40px;
  }

  .boutique-header h1 {
    font-family: 'Jost', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: #253461;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }

  .boutique-intro {
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    color: #626262;
    margin: 0;
  }

  /* Sections */
  .boutique-section {
    margin-bottom: 50px;
  }

  .section-heading {
    font-family: 'Jost', sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #253461;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    padding-bottom: 10px;
    border-bottom: 2px solid #469ADC;
    display: inline-block;
  }

  /* Grid */
  .categories-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  /* Card */
  .category-card {
    border: 1px solid #DCDCDC;
    border-radius: 16px;
    background: #FFFFFF;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .category-card:hover {
    border-color: #469ADC;
    box-shadow: 0 4px 16px rgba(70, 154, 220, 0.12);
  }

  .category-card-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 20px 12px;
    text-decoration: none;
    height: 100%;
    box-sizing: border-box;
  }

  .category-icon-wrapper {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .category-icon-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .category-name {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #253461;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .category-card:hover .category-name {
    color: #469ADC;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 768px) {
    .boutique-header h1 {
      font-size: 24px;
    }

    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .category-card-link {
      padding: 16px 8px;
    }

    .category-icon-wrapper {
      width: 48px;
      height: 48px;
    }

    .category-name {
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
