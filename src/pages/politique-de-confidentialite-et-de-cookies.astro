                    <td>S&eacute;curiser le site et pr&eacute;venir la fraude</td>
                    <td>Donn&eacute;es techniques, compte, paiement, activit&eacute;</td>
                    <td>Int&eacute;r&ecirc;t l&eacute;gitime</td>
                  </tr>
                  <tr>
                    <td>Am&eacute;liorer le site, les produits et les services</td>
                    <td>Donn&eacute;es techniques, statistiques, retours client</td>
                    <td>Int&eacute;r&ecirc;t l&eacute;gitime ou consentement lorsque requis</td>
                  </tr>
                  <tr>
                    <td>Envoyer des newsletters et communications marketing</td>
                    <td>Nom, e-mail, pr&eacute;f&eacute;rences, historique client</td>
                    <td>Consentement ou int&eacute;r&ecirc;t l&eacute;gitime lorsque permis</td>
                  </tr>
                  <tr>
                    <td>Utiliser des photos produits, exemples, portfolios et &eacute;tudes de cas</td>
                    <td>Photos produits, nom du club ou organisation, logos, informations g&eacute;n&eacute;rales de commande</td>
                    <td>Int&eacute;r&ecirc;t l&eacute;gitime ou consentement lorsque requis</td>
                  </tr>
                  <tr>
                    <td>Respecter nos obligations l&eacute;gales</td>
                    <td>Donn&eacute;es pertinentes selon l&rsquo;obligation</td>
                    <td>Obligation l&eacute;gale</td>
                  </tr>
                  <tr>
                    <td>D&eacute;fendre nos droits ou g&eacute;rer un litige</td>
                    <td>Commandes, paiements, &eacute;changes, preuves</td>
                    <td>Int&eacute;r&ecirc;t l&eacute;gitime ou obligation l&eacute;gale</td>
                  </tr>
                </tbody>
