---
/**
 * Product Detail Page - /products/[slug]
 * Fetches product data from Worker API and renders the product page
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductConfigurator from '../../components/ProductConfigurator.tsx';
import ContactFormPopup from '../../components/ContactFormPopup.tsx';
import TrustLogos from '../../components/TrustLogos.astro';
import '../../styles/steps.css';
import {
  siteConfig,
  getProductSchema,
  getBreadcrumbSchema,
  getFAQSchema,
  truncateDescription,
  stripHtml
} from '../../config/seo';
import { maillotClusterFaq } from '../../data/maillot-cluster-faq';
import { getGooglePlaceData } from '../../lib/google-places';

const WORKER_URL = import.meta.env.WORKER_URL || 'https://hercules-product-sync-fr-prod.gilles-86d.workers.dev';

// Get product slug from URL
const { slug } = Astro.params;

// Fetch product data
let product = null;
let error = null;

try {
  const response = await fetch(`${WORKER_URL}/product/${slug}`);
  if (response.ok) {
    product = await response.json();
  } else {
    error = `Product not found: ${slug}`;
  }
} catch (e) {
  error = `Failed to load product: ${e instanceof Error ? e.message : 'Unknown error'}`;
}

// Helper to format price
const formatPrice = (price: number | string) => {
  const num = typeof price === 'string' ? parseFloat(price) : price;
  return `${num.toFixed(2).replace('.', ',')} €`;
};

// Get conditional prices for display (use first variation with prices)
const getConditionalPrices = () => {
  if (!product?.variations?.length) return [];
  const variation = product.variations.find((v: any) => v.conditional_prices?.length);
  return variation?.conditional_prices || [];
};

// Get price range from all variations
const getPriceRange = () => {
  if (!product?.variations?.length) return null;

  let minPrice = Infinity;
  let maxPrice = 0;

  for (const variation of product.variations) {
    if (variation.conditional_prices?.length) {
      for (const cp of variation.conditional_prices) {
        if (cp.price < minPrice) minPrice = cp.price;
        if (cp.price > maxPrice) maxPrice = cp.price;
      }
    }
  }

  if (minPrice === Infinity) return null;
  return { min: minPrice, max: maxPrice };
};

const conditionalPrices = getConditionalPrices();
const priceRange = getPriceRange();

// Get lead time from first variation
const leadTime = product?.variations?.[0]?.lead_time || '';

// Parse price string that may use comma as decimal separator (e.g. "24,95" → 24.95)
const parsePrice = (val: number | string): number => {
  if (typeof val === 'number') return val;
  return parseFloat(val.replace(',', '.'));
};

// Fetch product config from WP API at build time (includes addons with price_tables)
let productConfig: any = null;
if (product) {
  try {
    const configRes = await fetch(`${WORKER_URL}/product-config/${slug}`);
    if (configRes.ok) {
      productConfig = await configRes.json();
    }
  } catch (e) {
    console.error('Failed to fetch product config:', e);
  }
}

// Build pricing table mirroring the steps form logic.
const buildPricingCombinations = () => {
  if (!productConfig) return { tiers: [], combos: [] };

  const variations = productConfig.variations || [];
  const pricedVariations = variations.filter((v: any) => v.conditional_prices?.length > 0);
  if (!pricedVariations.length) return { tiers: [], combos: [] };

  const tiers = pricedVariations[0].conditional_prices.map((cp: any) =>
    typeof cp.qty === 'string' ? parseInt(cp.qty) : cp.qty
  );

  const allAttrKeys = Object.keys(productConfig.attributes || {});
  const visibleAttrKeys = allAttrKeys.filter((key: string) => {
    const attr = productConfig.attributes[key];
    return !(attr.terms?.length === 1 && attr.terms[0].slug === 'default');
  });

  const addons = (productConfig.addons || []) as any[];
  const pricedParentAddons = addons.filter((a: any) =>
    a.parent_id === 0 && a.options?.some((o: any) => o.price_table?.length > 0)
  );

  type StepOption = { label: string; attrSlug?: string; attrKey?: string; addonId?: number; addonName?: string; priceTable?: any[] };
  type Step = { name: string; options: StepOption[] };
  const steps: Step[] = [];

  for (const attrKey of visibleAttrKeys) {
    const attr = productConfig.attributes[attrKey];
    steps.push({
      name: attr.display_title || attrKey,
      options: attr.terms.map((t: any) => ({
        label: t.name,
        attrSlug: t.slug,
        attrKey,
      })),
    });
  }

  for (const addon of pricedParentAddons) {
    const opts = addon.options || [];
    const freeOpts = opts.filter((o: any) => !o.price_table?.length);
    const pricedOpts = opts.filter((o: any) => o.price_table?.length > 0);

    if (opts.length <= 4) {
      steps.push({
        name: addon.name,
        options: opts.map((o: any) => ({
          label: o.name,
          addonId: addon.id,
          addonName: o.name,
          priceTable: o.price_table || [],
        })),
      });
    } else {
      const stepOptions: StepOption[] = [];

      if (freeOpts.length > 0) {
        stepOptions.push({
          label: freeOpts[0].name,
          addonId: addon.id,
          addonName: freeOpts[0].name,
          priceTable: [],
        });
      }

      const priceGroups = new Map<string, any>();
      for (const opt of pricedOpts) {
        const key = opt.price_table.map((p: any) => `${p.qty}:${p.price}`).join('|');
        if (!priceGroups.has(key)) {
          priceGroups.set(key, opt);
        }
      }

      const addonBaseName = addon.name
        .replace(/-Sélection/i, '').replace(/Sélection/i, '').replace(/-Couleur/i, '').replace(/-Choix/i, '').trim();
      if (priceGroups.size === 1) {
        const representative = priceGroups.values().next().value;
        stepOptions.push({
          label: `Avec ${addonBaseName}`,
          addonId: addon.id,
          addonName: representative.name,
          priceTable: representative.price_table,
        });
      } else {
        for (const [, opt] of priceGroups) {
          stepOptions.push({
            label: opt.name,
            addonId: addon.id,
            addonName: opt.name,
            priceTable: opt.price_table,
          });
        }
      }

      steps.push({ name: addon.name, options: stepOptions });
    }
  }

  if (steps.length === 0) return { tiers: [], combos: [] };

  type ComboRow = { labels: string[]; attrSelections: Record<string, string>; priceTables: any[][] };
  let rows: ComboRow[] = [{ labels: [], attrSelections: {}, priceTables: [] }];

  for (const step of steps) {
    if (rows.length * step.options.length > 100) continue;
    const newRows: ComboRow[] = [];
    for (const row of rows) {
      for (const opt of step.options) {
        const newAttrSelections = { ...row.attrSelections };
        if (opt.attrKey) {
          newAttrSelections[opt.attrKey] = opt.attrSlug!;
        }
        newRows.push({
          labels: [...row.labels, opt.label],
          attrSelections: newAttrSelections,
          priceTables: [...row.priceTables, ...(opt.priceTable?.length ? [opt.priceTable] : [])],
        });
      }
    }
    rows = newRows;
  }

  const getAddonPrice = (priceTable: any[], qty: number): number => {
    if (!priceTable?.length) return 0;
    const sorted = [...priceTable]
      .map((p: any) => ({ qty: typeof p.qty === 'string' ? parseInt(p.qty) : p.qty, price: parsePrice(p.price) }))
      .sort((a: any, b: any) => a.qty - b.qty);
    let price = 0;
    for (const tier of sorted) {
      if (tier.qty <= qty) price = tier.price;
    }
    return price;
  };

  const combos = rows.map((row: ComboRow) => {
    const matchedVar = pricedVariations.find((v: any) => {
      return Object.entries(v.attributes).every(([key, value]: [string, any]) => {
        const normalizedKey = key.replace('attribute_', '');
        const selected = row.attrSelections[key] || row.attrSelections[normalizedKey];
        return selected === value || value === 'default';
      });
    });

    const coversAllTiers = matchedVar ? tiers.every((qty: number) => {
      return matchedVar.conditional_prices.some((c: any) => {
        const cpQty = typeof c.qty === 'string' ? parseInt(c.qty) : c.qty;
        return cpQty === qty;
      });
    }) : false;

    const prices = tiers.map((qty: number) => {
      let basePrice = 0;
      if (matchedVar) {
        const cp = matchedVar.conditional_prices.find((c: any) => {
          const cpQty = typeof c.qty === 'string' ? parseInt(c.qty) : c.qty;
          return cpQty === qty;
        });
        basePrice = cp ? (parsePrice(cp.price)) : 0;
      }

      let addonTotal = 0;
      for (const pt of row.priceTables) {
        addonTotal += getAddonPrice(pt, qty);
      }

      return basePrice + addonTotal;
    });

    return { label: row.labels.join(' + '), prices, hasMatch: !!matchedVar, coversAllTiers };
  });

  const validCombos = combos.filter((c: any) => c.hasMatch && c.coversAllTiers);

  validCombos.sort((a: any, b: any) => a.prices[0] - b.prices[0]);

  return { tiers, combos: validCombos };
};

const pricingTable = buildPricingCombinations();

const startingPrice = pricingTable.combos.length > 0
  ? Math.min(...pricingTable.combos.flatMap((c: any) => c.prices))
  : null;

const tierPrices = pricingTable.combos.length > 0
  ? pricingTable.tiers.map((qty: number, i: number) => ({
      qty,
      price: pricingTable.combos[0].prices[i],
    }))
  : [];

// Generate WordPress thumbnail URL at specific size
const wpThumb = (url: string, size: number) => {
  if (!url) return url;
  return url.replace(/\.(jpg|jpeg|png|gif|webp)$/i, `-${size}x${size}.$1`);
};

// Generate Worker API image URL (cached on Cloudflare edge, served as WebP)
const workerImage = (index: number) => `${WORKER_URL}/image/${slug}/${index}`;
const workerThumb = (index: number) => `${WORKER_URL}/image/${slug}/${index}?size=thumb`;

// Convert image URL to WebP format (WordPress fallback)
const toWebP = (url: string) => {
  if (!url || url.endsWith('.webp')) return url;
  return url + '.webp';
};

// Get gallery images - Worker cached for fast LCP, WordPress for high-quality upgrade
const getGalleryImages = () => {
  if (!product?.images?.length) return [];
  return product.images.map((img: any, index: number) => {
    // Worker API images (cached on Cloudflare edge, WebP format) - fast but 361x361
    const workerSrc = workerImage(index);
    const workerThumbSrc = workerThumb(index);

    // WordPress full-size URL - higher quality for progressive enhancement
    const fullSrc = img.src || img.local_src;

    return {
      src: workerSrc,           // Worker cached image for fast LCP (361x361)
      srcFull: fullSrc,         // Full WordPress URL for high-quality upgrade
      srcset: '',               // No srcset - we'll upgrade via JS after load
      alt: img.alt || product.name,
      thumbnail: workerThumbSrc, // Thumbnail from Worker (fast)
    };
  });
};

const galleryImages = getGalleryImages();

// Fetch related products (products NOT in the same categories as current product)
let relatedProducts: any[] = [];
if (product) {
  try {
    const allProductsRes = await fetch(`${WORKER_URL}/products`);
    if (allProductsRes.ok) {
      const allProducts = await allProductsRes.json();
      // Get current product's category slugs
      const currentCategories = product.categories?.map((c: any) =>
        typeof c === 'string' ? c : c.slug
      ) || [];
      // Filter products that are NOT in the same categories and not the current product
      const otherProducts = allProducts.filter((p: any) => {
        if (p.slug === slug) return false;
        const pCategories = p.categories || [];
        // Check if any category overlaps
        const hasOverlap = pCategories.some((cat: string) => currentCategories.includes(cat));
        return !hasOverlap;
      });
      // Shuffle and take 5 random products
      const shuffled = otherProducts.sort(() => Math.random() - 0.5);
      relatedProducts = shuffled.slice(0, 5);
    }
  } catch (error) {
    console.error('Error fetching related products:', error);
  }
}

// Generate static paths for all products
export async function getStaticPaths() {
  const WORKER_URL = import.meta.env.WORKER_URL || 'https://hercules-product-sync-fr-prod.gilles-86d.workers.dev';

  try {
    const response = await fetch(`${WORKER_URL}/products`);
    const products = await response.json();

    return products
      .filter((p: any) => p.slug)
      .map((product: any) => ({
        params: { slug: product.slug },
      }));
  } catch (e) {
    console.error('Failed to fetch products for static paths:', e);
    return [];
  }
}

// SEO Data
const productUrl = `${siteConfig.siteUrl}/products/${slug}/`;
const productDescription = product?.short_description
  ? truncateDescription(stripHtml(product.short_description))
  : product?.description
    ? truncateDescription(stripHtml(product.description))
    : siteConfig.defaultDescription;

const productImage = galleryImages[0]?.src || `${siteConfig.siteUrl}${siteConfig.defaultImage}`;

// Build breadcrumb schema
const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
];
if (product?.categories?.[0]) {
  const cat = product.categories[0];
  const catName = typeof cat === 'string' ? cat : cat.name;
  const catSlug = typeof cat === 'string' ? cat : cat.slug;
  breadcrumbItems.push({
    name: catName,
    url: `${siteConfig.siteUrl}/collections/${catSlug}/`
  });
}
if (product) {
  breadcrumbItems.push({
    name: product.name,
    url: productUrl
  });
}

// Fetch Google review data (scraped at build time by fetch-google-reviews.mjs)
const placeData = await getGooglePlaceData();

// Build JSON-LD schemas
const jsonLdSchemas: object[] = [];

if (product) {
  // Product schema
  jsonLdSchemas.push(getProductSchema({
    name: product.name,
    description: productDescription,
    image: productImage,
    url: productUrl,
    sku: product.sku || `HERC-${product.id}`,
    brand: siteConfig.siteName,
    priceMin: startingPrice ?? priceRange?.min,
    priceMax: tierPrices.length > 0 ? Math.max(...tierPrices.map((t: { price: number }) => t.price)) : priceRange?.max,
    currency: 'EUR',
    availability: 'InStock',
    condition: 'NewCondition',
    offerCount: tierPrices.length || 1,
    priceSpecification: tierPrices.map((tp: any) => ({
      price: tp.price,
      quantity: tp.qty,
    })),
    aggregateRating: {
      ratingValue: placeData.rating,
      reviewCount: placeData.reviewCount,
    },
  }));

  // Breadcrumb schema
  jsonLdSchemas.push(getBreadcrumbSchema(breadcrumbItems));

  // FAQ schema (if product has FAQ data)
  const faqSchema = getFAQSchema(product.faq);
  if (faqSchema) {
    jsonLdSchemas.push(faqSchema);
  }

}

// Maillot cluster FAQ (plain HTML Q&A for SEO internal linking)
const clusterFaq = slug ? maillotClusterFaq[slug] : undefined;
if (product && clusterFaq) {
  const faqSchema = getFAQSchema(product.faq);
  if (!faqSchema) {
    const clusterFaqSchema = getFAQSchema(clusterFaq);
    if (clusterFaqSchema) {
      jsonLdSchemas.push(clusterFaqSchema);
    }
  }
}
---

<BaseLayout
  title={product?.name || 'Product'}
  description={productDescription}
  pageType="product"
  ogType="product"
  ogImage={productImage}
  productPrice={priceRange?.min?.toString()}
  productCurrency="EUR"
  productAvailability="InStock"
  jsonLd={jsonLdSchemas}
  preloadLcpImage={galleryImages[0] ? {
    src: galleryImages[0].src
  } : undefined}
>
  <div class="product-page">
    {error ? (
      <div class="error-container">
        <h1>Product not found</h1>
        <p>{error}</p>
        <a href="/" class="back-link">Retour à l'accueil</a>
      </div>
    ) : (
      <>
        <!-- Breadcrumb -->
        <nav class="breadcrumb">
          <div class="container">
            <a href="/">Accueil</a>
            <span class="separator"><svg xmlns="http://www.w3.org/2000/svg" width="6" height="12" viewBox="0 0 6 12" fill="none"><path d="M6 6L0.75 11.1962L0.75 0.803848L6 6Z" fill="#469ADC"></path></svg></span>
            {product.categories?.[0] && (
              <>
                <a href={`/collections/${product.categories[0].slug}/`}>{product.categories[0].name}</a>
                <span class="separator"><svg xmlns="http://www.w3.org/2000/svg" width="6" height="12" viewBox="0 0 6 12" fill="none"><path d="M6 6L0.75 11.1962L0.75 0.803848L6 6Z" fill="#469ADC"></path></svg></span>
              </>
            )}
            <span class="current">{product.name}</span>
          </div>
        </nav>

        <!-- Product Section -->
        <section class="product-section">
          <div class="container">
            <div class="product-grid">
              <!-- Left Column: Gallery -->
              <div class="product-gallery">
                <!-- Product Title wrapper - edge-to-edge border like WordPress -->
                <div class="product-title-wrapper">
                  <h1 class="product-title">{product.name}</h1>
                  {startingPrice && (
                    <span class="product-starting-price">À PARTIR DE {formatPrice(startingPrice)} HT</span>
                  )}
                </div>

                <!-- Main Image Container (badges positioned inside) -->
                <div class="main-image-container">
                  <!-- Badges inside image container -->
                  <div class="product-badges">
                    {product.green_product && (
                      <img src="/images/badges/green-option.svg?v=20260224" alt="Option durable" class="badge" />
                    )}
                    {product.made_in_europe && (
                      <img src="/images/badges/made-in-europe.svg?v=20260224" alt="Fabrication UE" class="badge" />
                    )}
                    {product.made_in_uk && (
                      <img src="/images/badges/made-in-uk.svg?v=20260224" alt="Fabrication UE" class="badge" />
                    )}
                  </div>

                  <!-- Gallery Navigation Arrows -->
                  {galleryImages.length > 1 && (
                    <>
                      <button class="gallery-arrow gallery-arrow-prev" id="gallery-prev" aria-label="Previous image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                      </button>
                      <button class="gallery-arrow gallery-arrow-next" id="gallery-next" aria-label="Next image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </button>
                    </>
                  )}

                  <!-- Main Image - Fast Worker cached image, upgrades to full quality after load -->
                  <div class="main-image">
                  <img
                    id="main-product-image"
                    src={galleryImages[0]?.src || '/images/placeholder.png'}
                    alt={product.name}
                    loading="eager"
                    fetchpriority="high"
                    width="600"
                    height="600"
                    data-full-src={galleryImages[0]?.srcFull}
                    data-upgraded="false"
                  />
                  </div>
                </div>

                <!-- Thumbnails Gallery with Pagination -->
                <!-- Show thumbnails even with 1 image so users see the gallery section -->
                {galleryImages.length >= 1 && (
                  <div class="thumbnail-gallery" id="thumbnail-gallery">
                    <ul class="thumbnail-list">
                      {galleryImages.map((img, index) => (
                        <li class={`thumbnail-item ${index === 0 ? 'active' : ''}`} style={index >= 20 ? 'display: none;' : ''}>
                          <img
                            src={img.thumbnail}
                            alt={img.alt}
                            loading={index === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                            width="100"
                            height="100"
                            data-full-src={img.src}
                            data-full-srcset={img.srcset}
                            data-original-src={img.srcFull}
                            data-index={index}
                          />
                        </li>
                      ))}
                    </ul>
                    <!-- Pagination Controls -->
                    {galleryImages.length > 20 && (
                      <div class="thumbnail-controls">
                        <button class="kd-go-back-btn" id="thumb-back" style="display: none;">Retour</button>
                        <button class="kd-show-more-btn" id="thumb-more">Voir plus</button>
                      </div>
                    )}
                  </div>
                )}
              </div>

              <!-- Right Column: Product Configurator Only -->
              <div class="product-info">
                <!-- Product Configurator (Pearl WC Steps) -->
                <ProductConfigurator
                  productSlug={slug as string}
                  workerUrl={WORKER_URL}
                  client:idle
                />

              </div>
            </div>

            <!-- Tabbed Section: Description / Prix / Design -->
            <div class="product-tabs-section" id="product-tabs">
              <div class="product-tabs-bar">
                <button class="product-tab active" data-tab="description">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  Description du produit
                </button>
                <button class="product-tab" data-tab="prices">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                  Prix
                </button>
                <button class="product-tab" data-tab="design">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                  Design
                </button>
              </div>

              <!-- Tab 1: Description du produit -->
              <div class="product-tab-content active" id="tab-description">
                <div class="description-content" set:html={product.description} />
              </div>

              <!-- Tab 2: Prix -->
              <div class="product-tab-content" id="tab-prices">
                <div class="prices-tab-layout">
                  <div class="prices-tab-sidebar">
                    <div class="prices-sidebar-card">
                      <div class="prices-info-row">
                        <div class="prices-info-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <div class="prices-info-text">
                          <h4>TOUS LES PRIX INCLUENT</h4>
                          <p>conception, production, emballage, contrôle qualité et envoi.</p>
                        </div>
                      </div>

                      <div class="prices-info-row">
                        <div class="prices-info-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
