    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: #253461;
  }

  .gallery-arrow:hover {
    background-color: #253461;
    color: white;
    border-color: #253461;
  }

  .gallery-arrow-prev {
    left: 10px;
  }

  .gallery-arrow-next {
    right: 10px;
  }

  .gallery-arrow svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 768px) {
